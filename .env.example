# Public canonical origin of the site (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://wolvo.example   # [DOMAIN — TO BE PROVIDED]

# Contact form delivery (server-only). Uses the Resend HTTP API when set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=        # [WOLVO INBOX — TO BE PROVIDED]
CONTACT_FROM_EMAIL=      # verified sender, e.g. "WOLVO Website <hello@your-domain>"
