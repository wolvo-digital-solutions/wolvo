# Public site URL — used for canonical, Open Graph, sitemap.xml and robots.txt.
VITE_SITE_URL=https://wolvo.agency

# Public contact email shown on the site and used for the mailto fallback.
VITE_CONTACT_EMAIL=hello@wolvo.agency

# Optional form endpoint (e.g. Formspree, Basin, or your own serverless function).
# Receives a JSON POST from the "Start a Project" form. Leave empty to fall back to mailto.
VITE_CONTACT_ENDPOINT=
